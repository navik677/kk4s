<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- kk4s: rlvm.exe on Windows passes UTF-8 to the narrow C runtime, Win32 "A"
     functions and Boost.Filesystem, as kk4s.exe does (platform/desktop/kk4s.manifest).
     Without this argv and file names use the ANSI code page, and a game folder
     with a Japanese name (Little Busters: KEY/リトルバスターズ！) is not found. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
