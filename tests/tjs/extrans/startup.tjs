// extrans.dll transitions (tests/extrans/smoke.py). The input script calls
// start("<method>") and takes a screenshot half-way; every transition must
// finish (onTransitionCompleted) and none may fall back to a cross-fade.
Plugins.link("extrans.dll");

class TransWindow extends Window {
    function TransWindow() {
        super.Window();
        setInnerSize(640, 480);
        add(new Layer(this, null));
        primaryLayer.setImageSize(640, 480);
        primaryLayer.setSizeToImageSize();
        primaryLayer.fillRect(0, 0, 640, 480, 0xff000000);
        visible = true;
    }
}
global.tw = new TransWindow();

class TransLayer extends Layer {
    var method;
    function TransLayer(win, par) {
        super.Layer(win, par);
        setImageSize(640, 480);
        setSizeToImageSize();
        type = ltOpaque; // like KAG's base layers: the background colour shows
    }
    function onTransitionCompleted(dest, src) {
        Debug.message("EXTRANS_DONE " + method);
        super.onTransitionCompleted(...);
    }
}

// sources: white -> black, or a black/white checkerboard of `cell` px going to
// black (mosaic: 2 px; ripple and its cross-fade control: 16 px, so that its
// displacement moves squares off their places)
function paint(l, cell) {
    l.fillRect(0, 0, 640, 480, 0xffffffff);
    if (cell)
        for (var y = 0; y < 480; y += cell)
            for (var x = (y \ cell) % 2 * cell; x < 640; x += cell * 2)
                l.fillRect(x, y, cell, cell, 0xff000000);
}

global.fore = void;
global.back = void;
function start(method, opts = %[], cell = 0) {
    if (fore !== void) { invalidate fore; invalidate back; }
    fore = new TransLayer(tw, tw.primaryLayer);
    back = new TransLayer(tw, tw.primaryLayer);
    paint(fore, cell);
    back.fillRect(0, 0, 640, 480, 0xff000000);
    fore.visible = true;
    back.visible = false;
    fore.method = method;
    var o = %[time: 1600];
    (Dictionary.assign incontextof o)(opts, false);
    fore.beginTransition(method, false, back, o);
    return "started " + method;
}
Debug.message("EXTRANS_READY");
